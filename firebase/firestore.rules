rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlayer(data) {
      return signedIn() && (
        data.s0 == request.auth.uid ||
        data.s1 == request.auth.uid ||
        data.s2 == request.auth.uid ||
        data.s3 == request.auth.uid
      );
    }

    function validName(value) {
      return value is string && value.size() >= 1 && value.size() <= 20;
    }

    // Date d'expiration (purge via la politique TTL Firestore) : entre maintenant et 8 jours.
    function validExpiry() {
      return request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt <= request.time + duration.value(8, 'd');
    }

    // Tous les sièges de la partie sont occupés.
    function allSeated(d) {
      return (d.n < 2 || d.s1 != '') && (d.n < 3 || d.s2 != '') && (d.n < 4 || d.s3 != '');
    }

    function validNewGame() {
      return signedIn()
        && request.resource.data.keys().hasAll([
          'n', 'tm', 'w', 'h', 's0', 's1', 's2', 's3',
          'name0', 'name1', 'name2', 'name3', 'moves', 'cur', 'ended', 'createdAt', 'expireAt'
        ])
        && request.resource.data.keys().hasOnly([
          'n', 'tm', 'w', 'h', 's0', 's1', 's2', 's3',
          'name0', 'name1', 'name2', 'name3', 'moves', 'cur', 'ended', 'createdAt', 'expireAt'
        ])
        && request.resource.data.n in [2, 3, 4]
        && request.resource.data.tm is bool
        && (!request.resource.data.tm || request.resource.data.n == 4)
        && request.resource.data.w in [11, 17, 23]
        && request.resource.data.h in [15, 23, 31]
        && request.resource.data.s0 == request.auth.uid
        && request.resource.data.s1 == ''
        && request.resource.data.s2 == ''
        && request.resource.data.s3 == ''
        && validName(request.resource.data.name0)
        && request.resource.data.name1 == ''
        && request.resource.data.name2 == ''
        && request.resource.data.name3 == ''
        && request.resource.data.moves is list
        && request.resource.data.moves.size() == 0
        && request.resource.data.ended == false
        && request.resource.data.cur == 0
        && request.resource.data.createdAt == request.time
        && validExpiry();
    }

    function validSeatClaim(seat, name, minimumPlayers) {
      return resource.data.n >= minimumPlayers
        && resource.data.ended == false
        && resource.data.expireAt > request.time
        && resource.data[seat] == ''
        && request.resource.data[seat] == request.auth.uid
        && validName(request.resource.data[name])
        && resource.data.s0 != request.auth.uid
        && resource.data.s1 != request.auth.uid
        && resource.data.s2 != request.auth.uid
        && resource.data.s3 != request.auth.uid;
    }

    function validMoveAppend() {
      let oldMoves = resource.data.moves;
      let newMoves = request.resource.data.moves;
      let oc = resource.data.get('cur', 0);
      let nc = request.resource.data.get('cur', 0);
      let last = resource.data.get('lastAt', resource.data.createdAt);
      // Série de coups consécutifs du même joueur (captures = il rejoue). Les règles ne peuvent pas rejouer le moteur de jeu :
      // elles plafonnent donc la série pour qu'un client modifié ne puisse pas garder la main indéfiniment (voir DEPLOIEMENT.md).
      let oldRun = resource.data.get('run', 0);
      let newRun = request.resource.data.get('run', 0);
      return isPlayer(resource.data)
        && request.time >= last + duration.value(250, 'ms')
        && resource.data.expireAt > request.time
        && allSeated(resource.data)
        && [resource.data.s0, resource.data.s1, resource.data.s2, resource.data.s3][oc] == request.auth.uid
        && nc is int
        && ((nc == oc && newRun is int && newRun == oldRun + 1 && newRun <= 16)
          || (nc == (oc + 1) % resource.data.n && newRun == 0))
        && resource.data.ended == false
        && request.resource.data.lastAt == request.time
        && newMoves is list
        && newMoves.size() == oldMoves.size() + 1
        && newMoves.size() <= 713
        && newMoves == oldMoves.concat([newMoves[oldMoves.size()]])
        && newMoves[oldMoves.size()] is int
        && newMoves[oldMoves.size()] >= 0
        && newMoves[oldMoves.size()] < resource.data.w * resource.data.h
        && !oldMoves.hasAny([newMoves[oldMoves.size()]]);
    }

    // Fin naturelle : les règles ne peuvent pas recalculer les cases verrouillées, mais une partie ne peut pas être
    // terminée avant que la moitié du plateau ait été jouée (l'abandon a ses propres règles : validResign / validForfeit).
    function validEnd() {
      return isPlayer(resource.data)
        && resource.data.ended == false
        && request.resource.data.ended == true
        && resource.data.moves.size() * 2 >= resource.data.w * resource.data.h;
    }

    // Abandon : un joueur peut clore la partie si le joueur dont c'est le tour est inactif depuis plus de 2 minutes.
    function validForfeit() {
      let c = resource.data.get('cur', 0);
      let last = resource.data.get('lastAt', resource.data.createdAt);
      return isPlayer(resource.data)
        && resource.data.ended == false
        && allSeated(resource.data)
        && request.resource.data.ended == true
        && request.resource.data.forfeit == c
        && [resource.data.s0, resource.data.s1, resource.data.s2, resource.data.s3][c] != request.auth.uid
        && request.time > last + duration.value(2, 'm');
    }

    // Abandon volontaire : un joueur assis déclare forfait pour lui-même.
    function validResign() {
      let seats = [resource.data.s0, resource.data.s1, resource.data.s2, resource.data.s3];
      let f = request.resource.data.get('forfeit', -1);
      return isPlayer(resource.data)
        && resource.data.ended == false
        && allSeated(resource.data)
        && request.resource.data.ended == true
        && f is int
        && f >= 0 && f < resource.data.n
        && seats[f] == request.auth.uid;
    }

    // Revanche : un joueur publie le code de la nouvelle partie une fois la partie terminée.
    function validRematch() {
      return isPlayer(resource.data)
        && (resource.data.ended == true || resource.data.moves.size() >= resource.data.w * resource.data.h)
        && resource.data.get('next', '') == ''
        && resource.data.get('nextBy', '') == ''
        && request.resource.data.keys().hasAll(['next', 'nextBy'])
        && request.resource.data.next is string
        && request.resource.data.nextBy == request.auth.uid
        && request.resource.data.next.matches('^[A-HJ-NP-Z2-9]{5}$');
    }

    // Calculer les champs modifiés une seule fois par écriture : les appels répétés à
    // Map.diff() dans chaque branche dépassaient le budget d'expressions de Firestore.
    function validGameUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn() && (
        changed.hasAny(['moves'])
          ? changed.hasOnly(['moves', 'cur', 'lastAt', 'run']) && validMoveAppend()
          : changed.hasAny(['s1', 'name1'])
            ? changed.hasOnly(['s1', 'name1']) && validSeatClaim('s1', 'name1', 2)
            : changed.hasAny(['s2', 'name2'])
              ? changed.hasOnly(['s2', 'name2']) && validSeatClaim('s2', 'name2', 3)
              : changed.hasAny(['s3', 'name3'])
                ? changed.hasOnly(['s3', 'name3']) && validSeatClaim('s3', 'name3', 4)
                : changed.hasAny(['forfeit'])
                  ? changed.hasOnly(['ended', 'forfeit']) && (validForfeit() || validResign())
                  : changed.hasAny(['ended'])
                    ? changed.hasOnly(['ended']) && validEnd()
                    : changed.hasAny(['next', 'nextBy'])
                      ? changed.hasOnly(['next', 'nextBy']) && validRematch()
                      : false
      );
    }

    // Suppression d'un salon d'attente : seul son créateur peut le retirer
    // tant qu'aucun autre joueur n'a pris de siège et qu'aucun coup n'a été joué.
    function canDeleteWaitingGame() {
      return signedIn()
        && resource.data.s0 == request.auth.uid
        && resource.data.s1 == ''
        && resource.data.s2 == ''
        && resource.data.s3 == ''
        && resource.data.moves is list
        && resource.data.moves.size() == 0
        && resource.data.ended == false;
    }

    match /games/{gameCode} {
      // Lecture par code uniquement (get) : impossible de lister ou d'énumérer les parties.
      // Seuls les joueurs assis modifient l'état, hormis la prise d'un siège libre.
      allow get: if signedIn();
      allow list: if false;
      allow create: if gameCode.matches('^[A-HJ-NP-Z2-9]{5}$') && validNewGame();
      allow update: if validGameUpdate();
      allow delete: if canDeleteWaitingGame();

      match /messages/{messageId} {
        function parentExists() {
          return exists(/databases/$(database)/documents/games/$(gameCode));
        }
        function parentData() {
          return get(/databases/$(database)/documents/games/$(gameCode)).data;
        }
        allow read: if signedIn() && parentExists() && isPlayer(parentData());
        allow create: if signedIn()
          && parentExists()
          && isPlayer(parentData())
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'expireAt'])
          && request.resource.data.keys().hasAll(['uid', 'text', 'createdAt', 'expireAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && validExpiry();
        allow update: if false;
        allow delete: if signedIn() && parentExists() && isPlayer(parentData())
          && ((resource.data.expireAt is timestamp && resource.data.expireAt <= request.time)
            || (resource.data.createdAt is timestamp && resource.data.createdAt + duration.value(1, 'd') <= request.time));
      }
    }

    // Partie rapide : annonces publiques (sans code), purgées par TTL sur expireAt ou supprimées par l'hôte.
    // La liste est autorisée mais ne révèle que des informations non sensibles (hôte anonyme, format de la partie).
    // L'annonce doit décrire exactement la partie (même hôte, joueurs, équipes, dimensions) : pas de fausse annonce.
    function lobbyMatchesGame(code) {
      let g = get(/databases/$(database)/documents/games/$(code)).data;
      return g.s0 == request.auth.uid
        && g.n == request.resource.data.n
        && g.tm == request.resource.data.tm
        && g.w == request.resource.data.w
        && g.h == request.resource.data.h;
    }

    match /lobby/{lobbyCode} {
      allow read: if signedIn();
      allow create: if signedIn()
        && lobbyCode.matches('^[A-HJ-NP-Z2-9]{5}$')
        && request.resource.data.keys().hasOnly(['host', 'n', 'tm', 'w', 'h', 'createdAt', 'expireAt'])
        && request.resource.data.keys().hasAll(['host', 'n', 'tm', 'w', 'h', 'createdAt', 'expireAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.n in [2, 3, 4]
        && request.resource.data.tm is bool
        && request.resource.data.w in [11, 17, 23]
        && request.resource.data.h in [15, 23, 31]
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt <= request.time + duration.value(2, 'h')
        && lobbyMatchesGame(lobbyCode);
      allow update: if false;
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }
  }
}
