{
  "name": "g2point",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "cf:schema": "wrangler d1 execute g2point --remote --file=cloudflare/schema.sql --config cloudflare/wrangler.toml",
    "cf:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "bench": "node scripts/bench.js",
    "train:sim": "node scripts/train-sim.js",
    "champion": "node scripts/champion.js",
    "test:champion": "node --test tests/slow/*.test.js",
    "ablation": "node scripts/ablation.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
